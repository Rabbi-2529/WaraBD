# ─────────────────────────────────────────────────────────────
# WaRa BD — Environment Variables (example)
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` — it's git-ignored.
# ─────────────────────────────────────────────────────────────

# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Site
DJANGO_SITE_URL=http://127.0.0.1:8000
DJANGO_DEFAULT_FROM_EMAIL=WaRa BD <noreply@warabd.local>
DJANGO_ADMIN_ORDER_EMAILS=admin@warabd.local

# Database — MySQL / MariaDB (defaults below match local XAMPP)
DJANGO_DB_NAME=warabd
DJANGO_DB_USER=root
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=3306

# Email (dev: console; prod: SMTP)
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True

# Redis (optional — for cache + sessions in prod)
REDIS_URL=